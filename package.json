{
  "name": "nakano-academy",
  "productName": "Nakano Academy",
  "version": "1.0.0",
  "description": "A Quintessential Quintuplets themed study app. Five tutors, five subjects, one 500/500 goal.",
  "main": "electron/main.cjs",
  "type": "module",
  "license": "MIT",
  "author": "Brian Nguyen (https://github.com/huy100408)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "icons": "node scripts/make-icon.mjs",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win",
    "dist": "vite build && electron-builder --mac --win",
    "build:site": "vite build -c vite.site.config.js && vite build --outDir site-dist/learn",
    "dev:site": "vite -c vite.site.config.js"
  },
  "build": {
    "appId": "io.github.nakanoacademy.app",
    "productName": "Nakano Academy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Nakano Academy ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Nakano Academy"
    },
    "artifactName": "NakanoAcademy-${os}-${arch}.${ext}",
    "protocols": [
      {
        "name": "Nakano Academy sign-in",
        "schemes": [
          "nakano"
        ]
      }
    ]
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "wait-on": "^8.0.5"
  },
  "homepage": "https://huy100408.github.io/nakano-academy/",
  "repository": {
    "type": "git",
    "url": "https://github.com/huy100408/nakano-academy.git"
  }
}
